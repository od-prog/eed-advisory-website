---
import { websiteConfig } from '@/config'
import { VERCEL_ENV } from 'astro:env/server'
import { ClientRouter } from 'astro:transitions'
import type { SeoMetadata } from 'cms/src/payload-types'
import { initGlobalState } from '../globalState'
import '../styles.css'
import Footer from './Footer.astro'
import Header from './Header.astro'
import SEOMetadata from './SEOMetadata.astro'

type Props = {
  meta: SeoMetadata
  lang: string
  home?: boolean
}

const { meta, lang, home = false } = Astro.props

await initGlobalState(Astro)
const { preview } = Astro.locals.globalState

const enablePlausible = VERCEL_ENV === 'production' && !preview && Boolean(websiteConfig.domain)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={websiteConfig.icon} sizes="any" type="image/svg+xml" />

    <SEOMetadata {...meta} />

    {enablePlausible && (
      <>
        <script
          is:inline
          id="psbl"
          data-domain={websiteConfig.domain}
          src="/js/script.js"
          async
        ></script>
        <script
          is:inline
          set:html={`window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }`}
        ></script>
      </>
    )}

    <ClientRouter />
    <script>
      import '../animations'
    </script>
  </head>
  <body>
    <Header alternatePaths={meta.alternatePaths} />
    <a class="eed-skip-link" href="#main-content">
      {lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}
    </a>
    <main id="main-content" class:list={[home ? 'eed-main-home' : 'py-32']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
