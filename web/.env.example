CMS_URL="http://localhost:3000" # The URL your CMS is hosted at. (e.g. http://localhost:3000 locally, and https://cms.mywebsite.com deployed)
WEBSITE_URL="http://localhost:4321" # The URL your Website is hosted at. (e.g. http://localhost:4321 locally and https://mywebsite.com deployed)
PUBLIC_MEDIA_ORIGIN="" # Approved public media host, without a trailing path. Required for production deployments.
PUBLIC_CONTACT_URL="" # Optional. Add the confirmed EED contact page URL to enable the homepage contact action.
PUBLIC_ANALYTICS_DOMAIN="" # Optional. Add the confirmed production hostname to enable Plausible Analytics.
VERCEL_ENV="development" # The environment the app is running in, automatically set by VERCEL when deployed
PREVIEW_SECRET="" # TODO: must match PREVIEW_SECRET in the cms .env file. Used to validate the signed preview tokens which protect the /preview routes.
